{
  "name": "combatzone",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/combatzone/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM",  "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Lobby"] }
  ]
}
